<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>Shamsa Alnahyan — Curator</title>

<style>
  :root {
    --ink: #141414;
    --paper: #ffffff;
    --magenta: #d94fc7;
    --cyan: #5fd9d9;
    --yellow: #ecd23f;
    --coral: #e9a768;
    --green: #86d874;
    color-scheme: light;
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    scroll-snap-type: y proximity;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: #ffffff;
    background-color: #ffffff;
    color: var(--ink);
    font-family: 'Andale Mono', 'Courier New', monospace;
    font-weight: 700;
    overflow-x: hidden;
  }

  /* ---------- Page shell ---------- */
  .page {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
    overflow: hidden;
    padding: 40px 24px;
  }

  /* ---------- Confetti bars (large, few, flat — matches reference mockup) ---------- */
  .bar {
    position: absolute;
    mix-blend-mode: multiply;
    opacity: 0.88;
    border-radius: 2px;
  }

  .page-confetti {
    min-height: 165vh;
    min-height: 165svh;
    align-items: stretch;
    justify-content: flex-start;
  }

  .confetti-base,
  .confetti-overlay {
    position: absolute;
    inset: 0;
  }

  /* smooths the scroll-linked motion instead of snapping 1:1 to scroll position —
     matches the eased feel from the earlier full-page confetti build */
  .confetti-overlay {
    transition: transform 0.18s ease-out;
    will-change: transform;
  }

  /* ---------- Scroll arrow between pages ---------- */
  .scroll-arrow {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: none;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: var(--ink);
    opacity: 0;
    cursor: pointer;
    padding: 10px 16px;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 20;
  }

  .page:hover .scroll-arrow,
  .scroll-arrow:focus-visible {
    opacity: 0.5;
  }

  .scroll-arrow:hover {
    opacity: 1;
    transform: translateX(-50%) translateY(3px);
  }

  /* ---------- Page 1: hero ---------- */
  .page-hero .hero-inner {
    position: relative;
    z-index: 5;
    text-align: center;
  }

  .logo-mark {
    width: 56px;
    height: 56px;
    object-fit: contain;
    margin-bottom: 18px;
  }

  h1.name {
    font-size: clamp(26px, 5vw, 42px);
    font-weight: 400;
    letter-spacing: 0.5px;
    margin: 0;
  }

  /* ---------- Page 3: about ---------- */
  .page-about .about-inner {
    position: relative;
    z-index: 5;
    max-width: 560px;
    width: 100%;
    text-align: center;
  }

  .lang-toggle {
    display: inline-flex;
    border: 1px solid var(--ink);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 26px;
    font-size: 13px;
  }

  .lang-toggle button {
    background: transparent;
    border: none;
    padding: 6px 18px;
    font-family: inherit;
    font-weight: 700;
    font-size: inherit;
    cursor: pointer;
    color: var(--ink);
  }

  .lang-toggle button.active {
    background: var(--ink);
    color: var(--paper);
  }

  .about {
    font-size: 15px;
    line-height: 1.7;
  }

  .about[dir="rtl"] { text-align: right; }

  /* ---------- Page 4: Curating / Consulting / Caring ---------- */
  .page-ccc {
    padding-top: 80px;
    padding-bottom: 60px;
    justify-content: flex-start;
  }

  .ccc-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 8px;
  }

  .ccc-buttons button {
    font-family: inherit;
    font-weight: 700;
    font-size: clamp(14px, 2vw, 18px);
    padding: 16px 30px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .ccc-buttons button.active { background: var(--ink); color: var(--paper); }
  .ccc-buttons button[data-tab="curating"].active { background: var(--magenta); border-color: var(--magenta); color: var(--ink); }
  .ccc-buttons button[data-tab="consulting"].active { background: var(--cyan); border-color: var(--cyan); color: var(--ink); }
  .ccc-buttons button[data-tab="caring"].active { background: var(--green); border-color: var(--green); color: var(--ink); }

  .ccc-panels {
    width: 100%;
    max-width: 640px;
    margin-top: 48px;
  }

  .panel { display: none; }
  .panel.active { display: block; animation: fadeIn 0.3s ease; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel h2 {
    font-size: 14px;
    font-weight: 400;
    margin: 0 0 24px;
    text-align: center;
    opacity: 0.55;
  }

  .work-item { margin-bottom: 40px; }
  .work-item .work-title { font-size: 18px; margin: 0 0 4px; }
  .work-item .work-meta { font-size: 12px; opacity: 0.6; margin: 0 0 14px; }

  .work-item .work-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: repeating-linear-gradient(45deg, #f2f2f2, #f2f2f2 10px, #fafafa 10px, #fafafa 20px);
    border: 1px solid #e4e4e4;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #999;
    margin-bottom: 14px;
  }

  .work-item p { font-size: 14px; line-height: 1.7; }

  .empty-state {
    font-size: 14px;
    opacity: 0.55;
    text-align: center;
    padding: 40px 0;
  }

  footer.contact {
    margin-top: 64px;
    text-align: center;
    font-size: 13px;
    border-top: 1px solid #eee;
    padding-top: 40px;
    width: 100%;
    max-width: 640px;
  }

  footer.contact .contact-label { display: block; opacity: 0.5; margin-bottom: 6px; }
  footer.contact a { color: var(--ink); text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .panel.active { animation: none; }
    .confetti-overlay { transition: none !important; }
  }
</style>
</head>
<body>

<!-- ============ PAGE 1: HERO ============ -->
<section class="page page-hero" id="page-1">
  <div class="confetti-local" aria-hidden="true">
    <div class="bar" style="width:clamp(160px,30vw,320px); height:clamp(50px,9vw,110px); left:3%; top:88%; background:var(--yellow); transform:rotate(-24deg);"></div>
    <div class="bar" style="width:clamp(150px,26vw,280px); height:clamp(46px,8vw,96px); left:76%; top:92%; background:var(--cyan); transform:rotate(18deg);"></div>
  </div>
  <div class="hero-inner">
    <img class="logo-mark" src="data:image/jpeg;base64," alt="Shamsa Alnahyan logo">
    <h1 class="name">Shamsa Alnahyan</h1>
  </div>
  <button type="button" class="scroll-arrow" data-target="#page-2" aria-label="Scroll to next page">⌄</button>
</section>

<!-- ============ PAGE 2: CONFETTI SHOWCASE ============ -->
<section class="page page-confetti" id="page-2">
  <div class="confetti-base" id="confetti-base-2" aria-hidden="true"></div>
  <div class="confetti-overlay" id="confetti-overlay-2" aria-hidden="true"></div>
  <button type="button" class="scroll-arrow" data-target="#page-3" aria-label="Scroll to next page">⌄</button>
</section>

<!-- ============ PAGE 3: ABOUT ME ============ -->
<section class="page page-about" id="page-3">
  <div class="confetti-local" aria-hidden="true">
    <div class="bar" style="width:clamp(150px,24vw,250px); height:clamp(50px,9vw,110px); left:4%; top:90%; background:var(--magenta); transform:rotate(20deg);"></div>
    <div class="bar" style="width:clamp(140px,22vw,230px); height:clamp(46px,8vw,96px); left:78%; top:88%; background:var(--green); transform:rotate(-16deg);"></div>
  </div>
  <div class="about-inner">
    <div class="lang-toggle">
      <button type="button" data-lang="en" class="active">EN</button>
      <button type="button" data-lang="ar">عربي</button>
    </div>
    <div class="about" id="about-text" dir="ltr">
      <p id="about-en">Blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah.</p>
      <p id="about-ar" style="display:none;">بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه بلاه.</p>
    </div>
  </div>
  <button type="button" class="scroll-arrow" data-target="#page-4" aria-label="Scroll to Curating, Consulting, Caring">⌄</button>
</section>

<!-- ============ PAGE 4: CURATING / CONSULTING / CARING + CONTACT ============ -->
<section class="page page-ccc" id="page-4">
  <nav class="ccc-buttons">
    <button type="button" data-tab="curating">Curating</button>
    <button type="button" data-tab="consulting">Consulting</button>
    <button type="button" data-tab="caring">Caring</button>
  </nav>

  <div class="ccc-panels">
    <section class="panel" id="panel-curating">
      <h2>Curating</h2>
      <div class="work-item">
        <p class="work-title">Exhibition title placeholder 01</p>
        <p class="work-meta">Venue, City — Month Year</p>
        <div class="work-media">exhibition photo / video</div>
        <p>Blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah.</p>
      </div>
      <div class="work-item">
        <p class="work-title">Exhibition title placeholder 02</p>
        <p class="work-meta">Venue, City — Month Year</p>
        <div class="work-media">exhibition photo / video</div>
        <p>Blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah.</p>
      </div>
    </section>

    <section class="panel" id="panel-consulting">
      <h2>Consulting</h2>
      <p class="empty-state">Nothing here yet — check back soon.</p>
    </section>

    <section class="panel" id="panel-caring">
      <h2>Caring</h2>
      <div class="work-item">
        <p class="work-title">Publication / writing title placeholder</p>
        <p class="work-meta">Month Year</p>
        <p>Blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah blah.</p>
      </div>
    </section>
  </div>

  <footer class="contact">
    <span class="contact-label">Get in touch</span>
    <a href="mailto:generic@gmail.com">generic@gmail.com</a>
  </footer>
</section>

<script>
  // ---------- Scroll arrows: click smooth-scrolls to next page ----------
  document.querySelectorAll('.scroll-arrow').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = document.querySelector(btn.dataset.target);
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // ---------- Language toggle (About Me only) ----------
  const langButtons = document.querySelectorAll('.lang-toggle button');
  const aboutText = document.getElementById('about-text');
  const aboutEn = document.getElementById('about-en');
  const aboutAr = document.getElementById('about-ar');

  langButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      langButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const lang = btn.dataset.lang;
      if (lang === 'ar') {
        aboutText.setAttribute('dir', 'rtl');
        aboutEn.style.display = 'none';
        aboutAr.style.display = 'block';
      } else {
        aboutText.setAttribute('dir', 'ltr');
        aboutEn.style.display = 'block';
        aboutAr.style.display = 'none';
      }
    });
  });

  // ---------- Curating / Consulting / Caring buttons ----------
  const tabButtons = document.querySelectorAll('.ccc-buttons button');
  const panels = document.querySelectorAll('.panel');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const alreadyActive = btn.classList.contains('active');
      tabButtons.forEach(b => b.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      if (!alreadyActive) {
        btn.classList.add('active');
        document.getElementById(`panel-${btn.dataset.tab}`).classList.add('active');
      }
    });
  });

  // ---------- Page 2: generated confetti bars ----------
  const palette = ['#d94fc7', '#5fd9d9', '#ecd23f', '#e9a768', '#86d874'];

  function makeRand(seed) {
    let s = seed;
    return function rand() {
      s = (s * 9301 + 49297) % 233280;
      return s / 233280;
    };
  }

  // clamp() string spanning a min/max px range, with a vw-based middle value
  // so bars scale smoothly between mobile and desktop
  function clampSize(maxPx, minPx) {
    const vw = (maxPx / 1400 * 100).toFixed(2);
    return `clamp(${minPx}px, ${vw}vw, ${maxPx}px)`;
  }

  function scatterBars(containerId, count, seedOffset) {
    const container = document.getElementById(containerId);
    const rand = makeRand(seedOffset);

    for (let i = 0; i < count; i++) {
      const big = rand() < 0.32;
      const wMax = Math.round(big ? 220 + rand() * 100 : 130 + rand() * 90);
      const hMax = Math.round(big ? 90 + rand() * 130 : 46 + rand() * 70);
      const left = 2 + rand() * 92;   // spread wide across the full width
      const top = rand() * 100;       // spread across the full (now taller) section
      const rot = -50 + rand() * 100;
      const color = palette[Math.floor(rand() * palette.length)];

      const el = document.createElement('div');
      el.className = 'bar';
      el.style.width = clampSize(wMax, Math.round(wMax * 0.48));
      el.style.height = clampSize(hMax, Math.round(hMax * 0.48));
      el.style.left = left + '%';
      el.style.top = top + '%';
      el.style.background = color;
      el.style.transform = `rotate(${rot}deg)`;
      container.appendChild(el);
    }
  }

  scatterBars('confetti-base-2', 20, 11);
  scatterBars('confetti-overlay-2', 16, 233);

  // ---------- Page 2: local confetti sweep ----------
  // The overlay layer's position is driven directly by how many pixels have
  // been scrolled since page-2's top came into view — continuous and
  // proportional to actual scroll distance, so the crossing motion stays
  // strong throughout the whole section (including near the end), rather
  // than being spread thin across a fixed small range.
  const page2 = document.getElementById('page-2');
  const overlay2 = document.getElementById('confetti-overlay-2');
  let ticking = false;

  function updateSweep() {
    const rect = page2.getBoundingClientRect();
    const scrolledPast = Math.min(Math.max(0, -rect.top), rect.height);
    overlay2.style.transform = `translateY(${scrolledPast * 0.4}px)`;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateSweep);
      ticking = true;
    }
  }, { passive: true });

  updateSweep();
</script>

</body>
</html>
